generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  fullName        String
  role            UserRole  @default(CUSTOMER)
  profilePicture  String?
  phoneNumber     String?
  address         String?
  referralCode    String    @unique
  isVerified      Boolean   @default(false)
  latestPoint     Float     @default(0) // FIX: Add latest point balance for quick access
  isActive        Boolean   @default(true) // FIX: Soft delete flag
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  eventsCreated   Event[]
  transactions    Transaction[]
  reviews         Review[]
  referralsGiven  Referral[] @relation("Referrer")
  referralsReceived Referral[] @relation("Referee")
  points          UserPoint[]
  pointHistories  PointHistory[] // FIX: Add point history tracking
  coupons         UserCoupon[]
  notifications   Notification[]
  attendees       EventAttendee[]

  @@map("users")
  @@index([email, isActive])
  @@index([referralCode])
  @@index([createdAt])
}

enum UserRole {
  CUSTOMER
  ORGANIZER
  ADMIN
}

model Event {
  id              String      @id @default(uuid())
  organizerId     String
  title           String
  description     String
  category        String
  location        String
  address         String
  startDate       DateTime
  endDate         DateTime
  imageUrl        String?
  imagePublicId   String? // FIX: Store Cloudinary public_id for deletion
  availableSeats  Int
  bookedSeats     Int         @default(0)
  soldQuantity    Int         @default(0) // FIX: Add sold quantity tracking
  basePrice       Float       @default(0)
  isPublished     Boolean     @default(false)
  isDeleted       Boolean     @default(false) // FIX: Soft delete flag
  deletedAt       DateTime?   // FIX: Track when event was deleted
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  version         Int         @default(1) // FIX: Optimistic locking version

  // Relations
  organizer       User        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  ticketTypes     EventTicketType[]
  vouchers        EventVoucher[]
  transactions    Transaction[]
  reviews         Review[]
  attendees       EventAttendee[]

  @@map("events")
  @@index([organizerId])
  @@index([category])
  @@index([location])
  @@index([startDate, endDate])
  @@index([isPublished, isDeleted])
  @@index([createdAt])
}

model EventTicketType {
  id                String    @id @default(uuid())
  eventId           String
  name              String
  price             Float
  quantity          Int
  soldQuantity      Int       @default(0)
  availableQuantity Int       @default(0) // FIX: Add available quantity for locking
  description       String?
  isDeleted         Boolean   @default(false) // FIX: Soft delete flag
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?             // FIX: Track when ticket type was deleted
  version           Int       @default(1) // FIX: Optimistic locking version

  // Relations
  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transactionItems  TransactionItem[]

  @@map("event_ticket_types")
  @@index([eventId])
  @@index([name])
}

model EventVoucher {
  id                  String        @id @default(uuid())
  eventId             String
  code                String        @unique
  discountType        DiscountType
  discountValue       Float
  maxUsage            Int
  usedCount           Int           @default(0)
  minPurchaseAmount   Float         @default(0)
  startDate           DateTime
  endDate             DateTime
  description         String?       // FIX: Add description field
  isDeleted           Boolean       @default(false) // FIX: Soft delete flag
  deletedAt           DateTime?     // FIX: Track deletion timestamp
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  version             Int           @default(1) // FIX: Optimistic locking version

  // Relations
  event               Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transactions        Transaction[]

  @@map("event_vouchers")
  @@index([eventId])
  @@index([code])
  @@index([startDate, endDate])
  @@index([isDeleted])
  @@index([createdAt])
}

model Transaction {
  id                  String            @id @default(uuid())
  userId              String
  eventId             String
  invoiceNumber       String            @unique
  status              TransactionStatus @default(WAITING_FOR_PAYMENT)
  totalAmount         Float
  pointsUsed          Float             @default(0)
  voucherId           String?
  voucherDiscount     Float             @default(0)
  couponId            String?
  couponDiscount      Float             @default(0)
  finalAmount         Float
  expiryTime          DateTime
  expiryWarningSent   Boolean           @default(false) // Untuk track expiry warnings
  failureReason       String?           // FIX: Add failure reason for rejected/expired transactions
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  isDeleted           Boolean           @default(false) // FIX: Soft delete flag
  deletedAt           DateTime?         // FIX: Track deletion timestamp
  version             Int               @default(1) // FIX: Optimistic locking version

  // Relations
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event               Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  voucher             EventVoucher?     @relation(fields: [voucherId], references: [id])
  coupon              UserCoupon?       @relation(fields: [couponId], references: [id])
  items               TransactionItem[]
  payment             TransactionPayment?
  review              Review?
  attendee            EventAttendee?

  @@map("transactions")
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([expiryTime])
  @@index([invoiceNumber])
  @@index([createdAt])
}

enum TransactionStatus {
  WAITING_FOR_PAYMENT
  WAITING_FOR_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
  SUCCESS
  CONFIRMED
  PENDING
}

model TransactionItem {
  id                String    @id @default(uuid())
  transactionId     String
  ticketTypeId      String
  quantity          Int
  pricePerTicket    Float
  subtotal          Float
  createdAt         DateTime  @default(now())

  // Relations
  transaction       Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  ticketType        EventTicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@map("transaction_items")
  @@index([transactionId])
  @@index([ticketTypeId])
  @@unique([transactionId, ticketTypeId]) // FIX: Prevent duplicate ticket types in same transaction
}

model TransactionPayment {
  id                String    @id @default(uuid())
  transactionId     String    @unique
  paymentProofUrl   String
  paymentProofPublicId String? // FIX: Store Cloudinary public_id for deletion
  paymentMethod     String?
  accountNumber     String?
  accountName       String?
  paymentDate       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  transaction       Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("transaction_payments")
  @@index([transactionId])
  @@index([paymentDate])
}

model Review {
  id              String    @id @default(uuid())
  userId          String
  eventId         String
  transactionId   String    @unique
  rating          Int       // 1-5
  comment         String?
  isActive        Boolean   @default(true) // FIX: Soft delete flag for reviews
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("reviews")
  @@index([userId])
  @@index([eventId])
  @@index([transactionId])
  @@index([rating])
  @@index([createdAt])
  @@unique([userId, transactionId]) // FIX: Prevent multiple reviews from same user for same event
}

model Referral {
  id                  String    @id @default(uuid())
  referrerId          String
  refereeId           String    @unique
  codeUsed            String
  isRewardClaimed     Boolean   @default(false)
  rewardPoints        Float     @default(0) // FIX: Track reward points
  createdAt           DateTime  @default(now())

  // Relations
  referrer            User      @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee             User      @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  coupons             UserCoupon[]

  @@map("referrals")
  @@index([referrerId])
  @@index([refereeId])
  @@index([codeUsed])
  @@index([createdAt])
}

model UserPoint {
  id              String    @id @default(uuid())
  userId          String
  amount          Float
  sourceType      String    // PURCHASE, REFERRAL, PROMOTION, REFUND, RESTORE
  sourceId        String?   // transaction_id, referral_id, etc.
  expiryDate      DateTime
  isExpired       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_points")
  @@index([userId])
  @@index([expiryDate])
  @@index([isExpired])
  @@index([sourceType])
  @@index([createdAt])
}

// FIX: Add PointHistory model for audit trail
model PointHistory {
  id              String    @id @default(uuid())
  userId          String
  points          Float     // Positive for earn, negative for redeem
  type            String    // EARN, REDEEM, RESTORE
  description     String?
  referenceId     String?   // transaction_id, etc.
  createdAt       DateTime  @default(now())

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_histories")
  @@index([userId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
}

model CouponTemplate {
  id                    String    @id @default(uuid())
  name                  String    @unique
  description           String?
  discountType          DiscountType
  discountValue         Float
  minPurchaseAmount     Float     @default(0)
  maxDiscountAmount     Float?
  isActive              Boolean   @default(true) // FIX: Soft delete flag
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  userCoupons           UserCoupon[]

  @@map("coupon_templates")
  @@index([name])
  @@index([isActive])
  @@index([createdAt])
}

model UserCoupon {
  id                  String    @id @default(uuid())
  userId              String
  couponTemplateId    String
  referralId          String?
  code                String    @unique
  isUsed              Boolean   @default(false)
  expiryDate          DateTime
  createdAt           DateTime  @default(now())

  // Relations
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponTemplate      CouponTemplate @relation(fields: [couponTemplateId], references: [id], onDelete: Cascade)
  referral            Referral?     @relation(fields: [referralId], references: [id])
  transactions        Transaction[]

  @@map("user_coupons")
  @@index([userId])
  @@index([code])
  @@index([expiryDate])
  @@index([isUsed])
  @@index([createdAt])
}

model Notification {
  id              String    @id @default(uuid())
  userId          String
  type            String    // TRANSACTION_UPDATE, EVENT_REMINDER, SYSTEM, etc.
  title           String
  message         String
  isRead          Boolean   @default(false)
  relatedId       String?   // transaction_id, event_id, etc.
  metadata        Json?     // FIX: Add metadata for additional data
  createdAt       DateTime  @default(now())

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model EventAttendee {
  id              String    @id @default(uuid())
  eventId         String
  userId          String
  transactionId   String    @unique
  ticketCount     Int
  totalPaid       Float
  attended        Boolean   @default(false)
  attendedAt      DateTime?
  checkinCode     String?   // FIX: Add check-in code for event entry
  createdAt       DateTime  @default(now())

  // Relations
  event           Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction     Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("event_attendees")
  @@index([eventId])
  @@index([userId])
  @@index([transactionId])
  @@index([attended])
  @@index([checkinCode])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// FIX: Add SystemSettings model for configuration
model SystemSettings {
  id              String    @id @default(uuid())
  key             String    @unique
  value           String
  description     String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("system_settings")
  @@index([key])
  @@index([isActive])
}

// FIX: Add AuditLog model for security tracking
model AuditLog {
  id              String    @id @default(uuid())
  action          String    // CREATE, UPDATE, DELETE, LOGIN, etc.
  resource        String    // User, Event, Transaction, etc.
  resourceId      String?
  userId          String?
  userIp          String?
  userAgent       String?
  oldValues       Json?
  newValues       Json?
  metadata        Json?
  createdAt       DateTime  @default(now())

  @@map("audit_logs")
  @@index([action])
  @@index([resource])
  @@index([userId])
  @@index([createdAt])
}